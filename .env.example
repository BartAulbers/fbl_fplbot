# Copy this file to .env and fill in your values
# cp .env.example .env

# ── FPL API ─────────────────────────────────────────────────────────────────
FPL_BASE_URL=https://fantasy.premierleague.com/api

# ── Squad / strategy settings ────────────────────────────────────────────────
SQUAD_BUDGET=100.0
RISK_APPETITE=0.5
HIT_THRESHOLD_PTS=5.0
DIFFERENTIAL_OWNERSHIP_CAP=10.0
CHURN_PREVENTION_MIN_GW_HOLD=5
FORM_WINDOW=5
FIXTURE_LOOKAHEAD=5

# ── Telegram bot ─────────────────────────────────────────────────────────────
# Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Optional: comma-separated Telegram user IDs allowed to use the bot
# Leave empty to allow everyone
# Example: TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
TELEGRAM_ALLOWED_USER_IDS=
